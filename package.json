{
  "name": "penguin",
  "private": true,
  "version": "1.16.0",
  "type": "module",
  "scripts": {
    "knowledge:benchmark:universal": "node scripts/with-temp-sandbox.mjs node scripts/knowledge-universal-retrieval-benchmark.mjs",
    "knowledge:real-questions": "node scripts/knowledge-real-question-audit.mjs",
    "knowledge:parity": "node scripts/knowledge-surface-parity.mjs",
    "knowledge:differential": "node scripts/knowledge-competitor-differential.mjs",
    "knowledge:package-smoke": "node scripts/knowledge-package-install-smoke.mjs",
    "knowledge:sbom": "node scripts/knowledge-sbom.mjs",
    "knowledge:release-gate": "node scripts/knowledge-release-gate.mjs",
    "knowledge:rollout:backup": "node scripts/knowledge-rollout-backup.mjs",
    "knowledge:docs:generate": "node scripts/knowledge-docs-generate.mjs",
    "knowledge:docs:check": "node scripts/knowledge-docs-generate.mjs --check",
    "knowledge:canary": "node scripts/knowledge-canary-audit.mjs",
    "knowledge:rc:audit": "node scripts/knowledge-rc-audit.mjs",
    "knowledge:model-bakeoff": "node scripts/knowledge-model-bakeoff.mjs",
    "knowledge:capability:gate": "node scripts/knowledge-product-capability-gate.mjs",
    "knowledge:capability:closure": "pnpm test && pnpm knowledge:capability:gate",
    "dev": "vite",
    "build": "pnpm -F @penguin/core build && pnpm -F @penguin/knowledge-contracts build && pnpm -F @penguin/broker-contracts build && pnpm -F @penguin/broker-core build && pnpm -F @penguin/knowledge-core build && pnpm -F @penguin/knowledge-indexer build && pnpm -F @penguin/api-doc-generator build && pnpm -F @penguin/knowledge-cli build && pnpm knowledge:bundle && tsc -b && vite build",
    "knowledge:bundle": "pnpm -F @penguin/core build && pnpm -F @penguin/knowledge-contracts build && pnpm -F @penguin/knowledge-core build && pnpm -F @penguin/knowledge-indexer build && pnpm -F @penguin/api-doc-generator build && pnpm -F @penguin/knowledge-cli build && pnpm -F @penguin/mcp build:dist && node scripts/bundle-knowledge-cli.mjs && node scripts/vendor-knowledge-runtime.mjs",
    "knowledge:release-bundle:gate": "node scripts/knowledge-release-bundle-gate.mjs",
    "knowledge:baseline": "node scripts/knowledge-baseline-snapshot.mjs --json",
    "knowledge:doctor": "node scripts/check-knowledge-runtime.mjs",
    "knowledge:benchmark": "node scripts/knowledge-quality-benchmark.mjs",
    "knowledge:benchmark:real": "node scripts/knowledge-real-repo-benchmark.mjs",
    "knowledge:retest:round8": "node scripts/knowledge-retest-round8.mjs",
    "knowledge:retest:round12": "node scripts/knowledge-retest-round12.mjs",
    "knowledge:retest:round14": "node scripts/knowledge-retest-round14.mjs",
    "knowledge:coverage-audit": "node scripts/knowledge-coverage-audit.mjs",
    "knowledge:round13:blackbox": "node scripts/knowledge-round13-blackbox.mjs",
    "knowledge:round13:contract": "pnpm run typecheck && node --test packages/knowledge-core/dist/__tests__/round13-contracts.test.js packages/knowledge-cli/dist/__tests__/round13-cli-contracts.test.js packages/mcp/dist/__tests__/round13-mcp-contracts.test.js",
    "knowledge:mcp:parity": "node scripts/with-temp-sandbox.mjs node scripts/knowledge-mcp-parity-test.mjs",
    "knowledge:round17:gate": "node scripts/knowledge-round17-acceptance.mjs --gate",
    "knowledge:round19:acceptance": "node scripts/knowledge-round19-acceptance.mjs",
    "knowledge:round19:gate": "node scripts/knowledge-round19-acceptance.mjs --gate",
    "preview": "vite preview",
    "broker:probe": "node scripts/broker-capability-probe.mjs",
    "broker:gate": "node scripts/broker-phase0-gate.mjs",
    "test": "node scripts/with-temp-sandbox.mjs node --test --test-concurrency=1 --test-reporter=dot tests/*.test.mjs",
    "test:ui": "vitest run",
    "test:ui:watch": "vitest",
    "test:verbose": "node scripts/with-temp-sandbox.mjs node --test --test-concurrency=1 --test-reporter=spec tests/*.test.mjs",
    "test:coverage": "node scripts/with-temp-sandbox.mjs node --test --test-concurrency=1 --test-reporter=dot --experimental-test-coverage tests/*.test.mjs",
    "typecheck": "pnpm -F @penguin/core build && pnpm -F @penguin/knowledge-contracts build && pnpm -F @penguin/broker-contracts build && pnpm -F @penguin/broker-core build && pnpm -F @penguin/knowledge-core build && pnpm -F @penguin/knowledge-indexer build && pnpm -F @penguin/api-doc-generator build && pnpm -F @penguin/knowledge-cli build && pnpm knowledge:bundle && tsc -b",
    "tauri": "tauri",
    "set-version": "node scripts/set-version.mjs"
  },
  "dependencies": {
    "3d-force-graph": "^1.80.0",
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.2",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.2",
    "@codemirror/lint": "^6.9.5",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.17",
    "@connectrpc/connect": "^1.5.0",
    "@connectrpc/connect-web": "^1.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lezer/highlight": "^1.2.3",
    "@penguin/broker-contracts": "workspace:*",
    "@penguin/broker-core": "workspace:*",
    "@penguin/core": "workspace:*",
    "@tailwindcss/oxide-darwin-arm64": "^4.2.1",
    "@tanstack/react-virtual": "^3.14.2",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "@tauri-apps/plugin-store": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.10.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "force-graph": "^1.51.4",
    "fuse.js": "^7.4.2",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sqlite-vec": "0.1.9",
    "tailwind-merge": "^3.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^5.0.1",
    "esbuild": "^0.28.1",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.4.3",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.1"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "protobufjs",
      "better-sqlite3"
    ]
  }
}
