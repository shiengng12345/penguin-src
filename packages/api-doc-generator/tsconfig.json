{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": "src",
    "outDir": "dist",
    "skipLibCheck": true
    ,"typeRoots": ["../knowledge-core/node_modules/@types"]
  },
  "include": ["src/**/*.ts"]
}
