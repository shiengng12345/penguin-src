.understand-anything/diff-overlay.json

# Local screenshot artifacts
config-editor-*.png

# Accidental shell redirect artifacts
pengvi@*
/tauri

# Tauri icon CLI by-products for unused platforms (we only ship macOS)
src-tauri/icons/ios/
src-tauri/icons/android/

# Generated self-contained knowledge CLI runtime (node binary + native + wasm)
packages/knowledge-cli/bundle/

# Generated self-contained MCP server runtime (node binary + native closure)
packages/mcp/bundle/

# Vendor download cache (node binaries + native prebuilds)
.cache/

# stray tsc outputs compiled next to sources (dist/ is the real build dir)
packages/*/src/*.js
packages/*/src/*.js.map
/-R

# Local-only JWT keys for the Broker local-secure profile. Never commit.
infra/broker/secure/*.key
infra/broker/secure/*.jwt

# Local-only TLS CA/broker certs and keys for the Broker local-secure
# profile (task 6: QAT TLS simulation). Generated by generate-tls-certs.sh.
# Never commit — regenerate locally instead.
infra/broker/secure/*.pem
infra/broker/secure/*.csr
infra/broker/secure/*.srl

# Vitest cache, created by the Broker module's UI test runner (vitest.config.ts).
.vitest/
